# =============================================================================
# AI Message Router - przykładowa konfiguracja
#
# Plik OPCJONALNY. Wszystkie zmienne mają wartości domyślne w docker-compose.yml
# i w api/src/ai_router/config.py, więc `docker compose up -d` działa bez .env.
# Aby nadpisać wartości: skopiuj ten plik do `.env` i odkomentuj wybrane linie.
# =============================================================================

# --- Docker Compose: obrazy (tag + digest), porty, zasoby ---------------------
# OLLAMA_IMAGE=alpine/ollama:0.40.3@sha256:...   # domyślnie lekki obraz CPU (121 MB)
# OLLAMA_GPU_IMAGE=ollama/ollama:0.40.3@sha256:... # pełny obraz z CUDA (docker-compose.gpu.yml)
# MAILPIT_IMAGE=axllent/mailpit:v1.31.5@sha256:...
# BIND_ADDRESS=127.0.0.1             # adres hosta dla portów; 0.0.0.0 = dostęp z sieci LAN
# API_PORT=8080                      # port hosta -> API (w kontenerze 8000)
# MAILPIT_UI_PORT=8025               # port hosta -> panel WWW Mailpit
# MAILPIT_SMTP_PORT=1025             # port hosta -> SMTP Mailpit (debug)
# OLLAMA_PORT=11435                  # port hosta -> Ollama (11435, by nie kolidować z lokalną Ollamą)
# OLLAMA_CPUS=8                      # limit rdzeni dla Ollamy
# OLLAMA_MEM_LIMIT=8g                # limit pamięci dla Ollamy (model ~4 GB)
# API_CPUS=1
# API_MEM_LIMIT=512m
# MAILPIT_MAX_AGE=7d                 # retencja przechwyconych maili (dane osobowe)
# PUBLIC_BASE_URL=http://localhost:8080  # adres API w linkach w mailach (informacja zwrotna)

# --- Ollama (serwer) i model ---------------------------------------------------
# OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M   # pobierany automatycznie przez ollama-init
# OLLAMA_MODEL_DIGEST=0edcdef34593   # opcjonalnie: start zatrzyma się, jeśli wagi są inne
# OLLAMA_CONTEXT_LENGTH=8192         # okno kontekstu; domyślne 4096 grozi cichym obcięciem promptu
# OLLAMA_KEEP_ALIVE=-1               # model zostaje w RAM (brak zimnych startów)
# OLLAMA_NUM_PARALLEL=1              # równoległe requesty na model (na CPU zostaw 1)

# --- API: LLM -------------------------------------------------------------------
# LLM_BACKEND=ollama                 # ollama | fake (deterministyczne reguły - CI, demo bez modelu)
# OLLAMA_BASE_URL=http://ollama:11434
# WARMUP_ON_STARTUP=true             # ładuje model i wypełnia KV cache instrukcji w tle
# READINESS_REQUIRE_WARM=false       # true = gotowość dopiero po rozgrzewce
# MODEL_WATCHDOG_INTERVAL_SECONDS=30 # ponowna rozgrzewka, gdy Ollama zgubi model (0 = wył.)
# LLM_TEMPERATURE=0.0
# LLM_SEED=42
# LLM_MAX_TOKENS=256
# LLM_THINKING=                      # puste = nie wysyłaj; false/true tylko dla modeli hybrydowych
# LLM_REQUEST_TIMEOUT_SECONDS=120

# --- API: agent i routing ---------------------------------------------------------
# ROUTING_POLICY_FILE=/config/routing-policy.yaml  # własna polityka (patrz config/README.md)
# AGENT_MODE=tool                    # tool | output_function (jedna runda LLM)
# AGENT_TIMEOUT_SECONDS=180
# AGENT_TOOL_RETRIES=2
# AGENT_OUTPUT_RETRIES=2
# AGENT_REQUEST_LIMIT=6
# MAX_CONCURRENT_AGENT_RUNS=1        # = OLLAMA_NUM_PARALLEL (nadmiar czekałby w Ollamie)
# AGENT_QUEUE_TIMEOUT_SECONDS=30     # tryb synchroniczny: potem 429 (użyj trybu async)
# MAX_MESSAGE_CHARS=4000
# ROUTING_FALLBACK_ENABLED=true
# CONFIDENCE_THRESHOLD=0.5           # poniżej: needs_review
# LOW_CONFIDENCE_ACTION=flag         # flag = oznacz; other = wyślij do działu fallback
# CONTEXT_WARNING_RATIO=0.8          # ostrzeżenie, gdy prompt zbliża się do okna kontekstu

# --- API: przechowywanie i outbox (SQLite w wolumenie api_data) ----------------------
# DATABASE_PATH=/app/data/ai-router.sqlite3
# TICKET_RETENTION_DAYS=30
# FEEDBACK_RETENTION_DAYS=180
# MAIL_SYNC_DELIVERY_TIMEOUT_SECONDS=5
# OUTBOX_MAX_ATTEMPTS=12
# OUTBOX_RETRY_BASE_SECONDS=2
# OUTBOX_RETRY_MAX_SECONDS=300
# IDEMPOTENCY_TTL_SECONDS=86400

# --- API: SMTP i treść maili -----------------------------------------------------
# SMTP_HOST=mailpit
# SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_STARTTLS=false
# SMTP_USE_TLS=false
# SMTP_TIMEOUT_SECONDS=10
# MAIL_FROM=AI Router <ai-router@example.com>
# MAIL_SUBJECT_PREFIX=[AI Router]
# MAIL_SUBJECT_LANGUAGE=pl           # pl (temat i uzasadnienie po polsku - czytają je działy) | auto (język wiadomości)
# MAIL_MESSAGE_ID_DOMAIN=ai-router.local

# --- API: bezpieczeństwo ------------------------------------------------------------
# AUTH_MODE=none                     # none | api_key | oidc  (none: tylko localhost!)
# API_KEYS=intranet:<sha256 klucza>  # make api-key wygeneruje klucz i wpis
# OIDC_JWKS_URL=https://sso.firma.pl/.well-known/jwks.json
# OIDC_AUDIENCE=ai-router
# OIDC_ISSUER=https://sso.firma.pl
# OIDC_EMAIL_CLAIM=email
# ADMIN_TOKEN=                       # wymagany do /api/v1/feedback/export przy AUTH_MODE!=none
# RATE_LIMIT_PER_MINUTE=30           # na klienta (klucz/użytkownik/IP); 0 = wyłączone
# RATE_LIMIT_BURST=10
# FEEDBACK_ENABLED=true
# FEEDBACK_SECRET=                   # puste = wygenerowany raz i trzymany w bazie

# --- API: obserwowalność i logi ---------------------------------------------------------
# METRICS_ENABLED=true               # /metrics (Prometheus)
# OTEL_EXPORTER_OTLP_ENDPOINT=       # np. http://jaeger:4318 (ustawia docker-compose.observability.yml)
# TRACE_INCLUDE_CONTENT=false        # true = treść promptów w śladach (dane osobowe!)
# LOG_LEVEL=INFO
# LOG_FORMAT=json                    # json | console
# LOG_MESSAGE_CONTENT=false          # true = pełna treść wiadomości w logach (tylko debug!)

# --- Obserwowalność (nakładka) -------------------------------------------------------
# GRAFANA_PORT=3000
# PROMETHEUS_PORT=9090
# JAEGER_UI_PORT=16686
# GRAFANA_ADMIN_PASSWORD=admin
