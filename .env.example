# =============================================================================
# AI Message Router - przykładowa konfiguracja
#
# Plik OPCJONALNY. Wszystkie zmienne mają wartości domyślne w docker-compose.yml
# i w api/src/ai_router/config.py, więc `docker compose up -d` działa bez .env.
# Aby nadpisać wartości: skopiuj ten plik do `.env` i odkomentuj wybrane linie.
# =============================================================================

# --- Docker Compose: wersje obrazów i porty hosta ----------------------------
# OLLAMA_VERSION=0.40.3              # tag obrazu ollama/ollama
# MAILPIT_VERSION=v1.31.5            # tag obrazu axllent/mailpit (z prefiksem "v")
# BIND_ADDRESS=127.0.0.1             # adres hosta dla portów; 0.0.0.0 = dostęp z sieci LAN
# API_PORT=8080                      # port hosta -> API (w kontenerze 8000)
# MAILPIT_UI_PORT=8025               # port hosta -> panel WWW Mailpit
# MAILPIT_SMTP_PORT=1025             # port hosta -> SMTP Mailpit (debug)
# OLLAMA_PORT=11435                  # port hosta -> Ollama (11435, by nie kolidować z lokalną Ollamą na 11434)

# --- Ollama (serwer) -----------------------------------------------------------
# OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M   # model LLM (pobierany automatycznie przez ollama-init)
# OLLAMA_CONTEXT_LENGTH=8192         # okno kontekstu; domyślne 4096 grozi cichym obcięciem promptu
# OLLAMA_KEEP_ALIVE=24h              # jak długo model zostaje w RAM po ostatnim użyciu
# OLLAMA_NUM_PARALLEL=1              # równoległe requesty na model (na CPU zostaw 1)

# --- API: połączenie z LLM -----------------------------------------------------
# OLLAMA_BASE_URL=http://ollama:11434  # adres Ollamy widziany z kontenera api (bez /v1)
# WARMUP_ON_STARTUP=true             # rozgrzewka (załadowanie) modelu w tle przy starcie API
# LLM_TEMPERATURE=0.0                # 0 = najbardziej powtarzalne decyzje
# LLM_SEED=42                        # ziarno losowości (powtarzalność)
# LLM_MAX_TOKENS=400                 # limit długości pojedynczej odpowiedzi modelu
# LLM_THINKING=                      # puste = nie wysyłaj; false/true tylko dla modeli hybrydowych (np. qwen3.5)
# LLM_REQUEST_TIMEOUT_SECONDS=120    # timeout pojedynczego wywołania LLM

# --- API: agent i routing --------------------------------------------------------
# AGENT_TIMEOUT_SECONDS=180          # timeout całego przebiegu agenta
# AGENT_TOOL_RETRIES=2               # ponowienia przy błędnych argumentach narzędzia
# AGENT_OUTPUT_RETRIES=2             # ponowienia, gdy model nie wywołał narzędzia
# AGENT_REQUEST_LIMIT=6              # maks. liczba zapytań do modelu w jednym przebiegu
# MAX_CONCURRENT_AGENT_RUNS=2        # ile przebiegów agenta naraz (semafor)
# AGENT_QUEUE_TIMEOUT_SECONDS=30     # czas oczekiwania na wolny slot, potem HTTP 429
# MAX_MESSAGE_CHARS=4000             # maks. długość wiadomości użytkownika
# ROUTING_FALLBACK_ENABLED=true      # gdy agent zawiedzie: wyślij do other@example.com zamiast błędu

# --- API: SMTP i treść maili -----------------------------------------------------
# SMTP_HOST=mailpit
# SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_STARTTLS=false
# SMTP_USE_TLS=false
# SMTP_TIMEOUT_SECONDS=10
# MAIL_FROM=AI Router <ai-router@example.com>
# MAIL_SUBJECT_PREFIX=[AI Router]
# MAIL_MESSAGE_ID_DOMAIN=ai-router.local

# --- API: idempotencja -----------------------------------------------------------
# IDEMPOTENCY_TTL_SECONDS=86400      # jak długo pamiętać odpowiedź dla Idempotency-Key
# IDEMPOTENCY_MAX_ENTRIES=10000      # maks. liczba zapamiętanych kluczy

# --- API: logi -------------------------------------------------------------------
# LOG_LEVEL=INFO
# LOG_FORMAT=json                    # json | console
# LOG_MESSAGE_CONTENT=false          # true = loguj pełną treść wiadomości (tylko do debugowania!)
